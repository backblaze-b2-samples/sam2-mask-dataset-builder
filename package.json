{
  "name": "sam2-mask-dataset-builder",
  "private": true,
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @sam2-mask-dataset-builder/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @sam2-mask-dataset-builder/web build",
    "typecheck": "pnpm --filter @sam2-mask-dataset-builder/web typecheck",
    "lint": "pnpm --filter @sam2-mask-dataset-builder/web lint",
    "lint:ci": "node scripts/check-ci-security.mjs",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @sam2-mask-dataset-builder/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "1.19.15",
      "ajv@6": "6.14.0",
      "ajv@8": "8.20.0",
      "body-parser": "2.3.0",
      "brace-expansion@1": "1.1.17",
      "brace-expansion@2": "2.1.3",
      "express-rate-limit": "8.6.2",
      "fast-uri": "3.1.5",
      "flatted": "3.4.4",
      "hono": "4.13.2",
      "ip-address": "10.5.0",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "minimatch@10": "10.2.6",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.2",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.5",
      "postcss": "8.5.26",
      "qs": "6.15.3",
      "shell-quote": "1.10.0"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": "10.25.0"
  }
}
